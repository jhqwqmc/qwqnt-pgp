{
  "$schema": "https://raw.githubusercontent.com/qwqnt-community/types/main/plugin.schema.json",
  "name": "qwqnt-pgp",
  "version": "0.2.2",
  "description": "QwQNT 的 PGP 加密插件：基于 GnuPG 的端到端加密，支持合并转发发送、文本切片、密钥与联系人管理",
  "type": "module",
  "scripts": {
    "lint": "oxlint src --tsconfig ./tsconfig.json --type-aware --type-check",
    "build": "pnpm lint && node build.mjs"
  },
  "author": "jhqwqmc",
  "homepage": "https://github.com/jhqwqmc/qwqnt-pgp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhqwqmc/qwqnt-pgp.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@qwqnt/types": "github:qwqnt-community/types",
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "jszip": "3.10.2",
    "vite": "^8.2.2"
  },
  "packageManager": "pnpm@11.23.0",
  "qwqnt": {
    "name": "PGP 加密",
    "inject": {
      "main": "./main/index.js",
      "preload": "./preload/index.cjs",
      "renderer": "./renderer/index.js"
    },
    "dependencies": {
      "qwqnt-hako": "^1.0.0",
      "qwqnt-ipc-interceptor": "^1.2.1"
    }
  }
}
